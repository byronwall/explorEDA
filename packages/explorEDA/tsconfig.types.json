{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "incremental": false
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/test",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__"
  ]
}
