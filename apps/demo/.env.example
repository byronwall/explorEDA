# Copy to .env.development.local for local runs. The deployed site reads the
# same names from GitHub repository variables (see .github/workflows/deploy.yml).

# The site's own license key, so its workspaces show no notice.
VITE_EXPLOREDA_LICENSE_KEY=

# Pricing and license pages. Leave the Paddle values empty and the pricing
# page offers invoices instead of checkout.
VITE_LICENSE_SERVICE_URL=http://localhost:8787
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_COMMERCIAL=
VITE_PADDLE_PRICE_OEM=
VITE_TURNSTILE_SITE_KEY=
