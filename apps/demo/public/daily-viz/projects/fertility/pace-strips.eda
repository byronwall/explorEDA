eda query=decades
dashboard "The pace of fertility change is not uniform across decades"
grid columns=12 rowHeight=76
composition @cp-fertility-pace-strips width=1030 height=850 at=0,0,12,9 {
  title "The pace of fertility change is not uniform across decades" at=32,28 fontSize=24
  subtitle "Color encodes the first-to-last annualized change for each country-decade." at=32,78 fontSize=13
  scale position decades.decade
  scale value Pace center=#f7f7f7 colors=#2166ac,#b2182b transform=linear
  unit Countries at=34,185 size=675x30 {
    repeat decades.country arrangement=rows gap=15 order=label
    label width=240 fontSize=12
    strip Pace position=decades.decade valueScale=Pace aggregation=average measureField=decades.annual_change encoding=color
  }
  legend "Births per woman per elapsed year" at=300,118 unit=Countries mark=Pace scale=Pace
  footnote "World Bank, UN and national statistical sources; historical snapshot; CC BY 4.0." at=32,796 fontSize=10
  footnote "Units, denominator, transformation and evidence: companion design note; snapshot findings do not change with filters." at=32,818 fontSize=10
}
