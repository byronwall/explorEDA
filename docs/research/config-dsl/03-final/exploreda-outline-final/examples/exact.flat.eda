source orders=salesRows
revenue:num=Revenue
order="Order ID"
use orders

table @rows
+ columns=[{"id":"order","field":"Order ID","width":140},{"id":"rev","field":"Revenue","width":180}]
+ globalSearch="true" sortBy=Revenue sortDirection=desc

scatter @margin
+ config={"xField":"Revenue","yField":"Margin","pointSize":3,"margin":{"left":64}}
+ filters=[{"type":"range","field":"Revenue","min":100,"max":500}]
