project @shop

source @customers key=customerId path=data/customers.csv {
  field customerId string
  field name string
  field joinedAt Joined date
}

source @orders key=orderId path=data/orders.csv {
  field orderId string
  field customerId string
  field amount number
  field orderedAt Ordered date
}

source @items key=itemId path=data/items.csv {
  field itemId string
  field orderId string
  field productId string
  field revenue number
}

source @products key=productId path=data/products.csv {
  field productId string
  field name Product string
}

relate @order-customer orders.customerId -> customers.customerId
relate @item-order items.orderId -> orders.orderId
relate @item-product items.productId -> products.productId

param @customer "Customer" string required pick=customers.name
param @from "From" date required
param @until "Until" date required

query @orders-with-customers "Orders with customers" glyph=◆ {
  source orders
  lookup customer via=order-customer
}

query @items-with-orders-products "Items with orders and products" glyph=▲ {
  source items
  lookup order via=item-order
  lookup product via=item-product
}

query @customer-orders "One customer's orders" glyph=● {
  source orders
  filter @chosen-customer orders.customerId = $customer
  filter @after-from orders.orderedAt >= $from
  filter @before-until orders.orderedAt <= $until
}

query @revenue-by-product "Revenue by product" glyph=■ {
  source items
  lookup product via=item-product
  filter @min-revenue items.revenue >= 10
  aggregate @by-product by=product.name {
    sum @revenue items.revenue
  }
}
