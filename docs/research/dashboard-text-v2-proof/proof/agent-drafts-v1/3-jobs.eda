dashboard "The changing nature of middle-class jobs"
grid columns=12 rowHeight=100

composition @jobs height=704 {
  scale numeric Year nice=false zero=false ticks=ends
  scale numeric "Jobs per 1000" max=85
  scale value "Women minus men" type=diverging range=#1a8fd0,#b9b9b9,#e3173b max=100 label="Share of women minus share of men, points"
  measure max("Group order")
  measure max("Group change") name=change
  title "The Changing Nature of Middle-Class Jobs" at=32,24 fontSize=26
  subtitle "Jobs per 1,000 workers by occupation, 1980 to 2020" at=32,64
  footnote "Source: U.S. Census Bureau, American Community Survey" at=32,680
  unit Groups at=56,176 size=120x180 axis=true {
    repeat Group columns=5 gap=46 orderBy="Group order" limit=10
    label fontSize=11 value=change format="+N jobs"
    path Occupations x=Year y="Jobs per 1000" orderField=Year series=Occupation color="Women minus men"
    point Ends x=Year y="Jobs per 1000" pick=ends
  }
  legend Key at=620,130 unit=Groups mark=Occupations layout=row
  note "Registered nurses" at=-30,-40 on=Groups[Professionals] mark=Occupations pick=max
  note "Secretaries" at=-30,-40 on=Groups["Admin support"] mark=Occupations pick=max
}
row Group
hist "Women share"

layout {
  7: jobs
  4: Group "Women share"
}
