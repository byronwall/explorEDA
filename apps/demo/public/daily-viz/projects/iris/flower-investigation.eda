eda query=r
dashboard "Follow the same flowers across several measurements"
grid columns=12 rowHeight=76
sepal_length:num=r.sepal_length label="Sepal length (cm)"
sepal_width:num=r.sepal_width label="Sepal width (cm)"
petal_length:num=r.petal_length label="Petal length (cm)"
petal_width:num=r.petal_width label="Petal width (cm)"
species:cat=r.species label="Species"
scatter @db-iris-flower-investigation-view-1 x=petal_length y=petal_width color=species title="Petal dimensions" at=0,0,8,5 x.title="Petal length (cm)" y.title="Petal width (cm)"
row @db-iris-flower-investigation-view-2 species title="Select species" at=8,0,4,5 x.title="Rows"
scatter @db-iris-flower-investigation-view-3 x=sepal_length y=sepal_width color=species title="Sepal dimensions of the same flowers" at=0,5,6,4 x.title="Sepal length (cm)" y.title="Sepal width (cm)"
hist @db-iris-flower-investigation-view-4 petal_length bins=20 title="Brush petal length" at=6,5,6,4 x.title="Petal length (cm)" y.title="Rows"
parallel @db-iris-flower-investigation-view-5 sepal_length,sepal_width,petal_length,petal_width color=species title="Four measurements per flower" at=0,9,8,5
metric @db-iris-flower-investigation-view-6 count title="Flowers matching the filters" at=8,9,4,2
table @db-iris-flower-investigation-records species,sepal_length,sepal_width,petal_length,petal_width title="Matching source records and lookup values" at=0,14,12,5
