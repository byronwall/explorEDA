eda query=r
dashboard "Investigate wine chemistry by cultivar"
grid columns=12 rowHeight=76
alcohol:num=r.alcohol label="Alcohol (% vol)"
magnesium:num=r.magnesium label="Magnesium (mg/L)"
flavanoids:num=r.flavanoids label="Flavanoids"
color_intensity:num=r.color_intensity label="Color intensity"
hue:num=r.hue label="Hue"
proline:num=r.proline label="Proline (mg/L)"
cultivar:cat=r.cultivar label="Cultivar"
scatter @db-wine-assay-investigation-view-1 x=flavanoids y=color_intensity color=cultivar title="Flavanoids and color intensity" at=0,0,8,5 x.title="Flavanoids" y.title="Color intensity"
row @db-wine-assay-investigation-view-2 cultivar title="Select a cultivar" at=8,0,4,5 x.title="Rows"
hist @db-wine-assay-investigation-view-3 flavanoids bins=24 title="Brush flavanoid values" at=0,5,6,4 x.title="Flavanoids" y.title="Rows"
scatter @db-wine-assay-investigation-view-4 x=alcohol y=proline color=cultivar title="Alcohol and proline" at=6,5,6,4 x.title="Alcohol (% vol)" y.title="Proline (mg/L)"
parallel @db-wine-assay-investigation-view-5 alcohol,magnesium,flavanoids,color_intensity,proline color=cultivar title="Selected chemical axes" at=0,9,8,5
metric @db-wine-assay-investigation-view-6 count title="Wine analyses matching the filters" at=8,9,4,2
table @db-wine-assay-investigation-records cultivar,alcohol,flavanoids,color_intensity,hue,proline title="Matching source records and lookup values" at=0,14,12,5
