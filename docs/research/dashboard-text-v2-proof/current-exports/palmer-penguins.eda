### VIEW: Penguin field notes
dashboard name="Penguin field notes"
grid rowHeight=76 padding=0 markers=false

scale @species-colors field=species
+ palette[]="#3479a8","#c77a45","#4b9688","#9c6eac","#bd596a"
+ mapping[]= mapping.0[]=Adelie,"#3479a8"
+ mapping.1[]=Chinstrap,"#c77a45" mapping.2[]=Gentoo,"#4b9688"
+ paletteId=unset order=unset overflow=unset

scatter x=flipper_length_mm y=body_mass_g @penguin-size
+ at=0,0,6,5 color=species title="Body size & flipper length"
+ xAxis{}= xAxis.grid=false yAxis{}= yAxis.grid=true
+ margin.top=16 margin.right=24 margin.bottom=44 margin.left=62
+ xAxisLabel="Flipper length (mm)" yAxisLabel="Body mass (g)"
+ yGridLines=4
row species @penguin-species at=6,0,3,5 color=species
+ title="Species · shared color key" xAxis{}= xAxis.grid=true
+ yAxis{}= yAxis.grid=false margin.top=16 margin.right=24
+ margin.bottom=44 margin.left=62 xAxisLabel=Records
+ yGridLines=4 minRowHeight=22 maxRowHeight=36
row island @penguin-island at=9,0,3,5 title="Sampling islands"
+ xAxis{}= xAxis.grid=true yAxis{}= yAxis.grid=false
+ margin.top=16 margin.right=24 margin.bottom=44 margin.left=62
+ xAxisLabel=Records yGridLines=4 minRowHeight=22
+ maxRowHeight=36
scatter x=bill_length_mm y=bill_depth_mm @penguin-bill
+ at=0,5,4,4 color=species title="Bill shape separates species"
+ xAxis{}= xAxis.grid=false yAxis{}= yAxis.grid=true
+ margin.top=16 margin.right=24 margin.bottom=44 margin.left=62
+ xAxisLabel="Bill length (mm)" yAxisLabel="Bill depth (mm)"
+ yGridLines=4
chart boxplot field=body_mass_g @penguin-mass at=4,5,4,4
+ color=species title="Body mass by species" xAxis{}=
+ xAxis.grid=false yAxis{}= yAxis.grid=true margin.top=16
+ margin.right=24 margin.bottom=44 margin.left=62
+ yAxisLabel="Body mass (g)" yGridLines=4
+ styles.boxFill="#3479a8" styles.boxStroke="#3479a8"
+ styles.boxStrokeWidth=0 styles.whiskerStroke="#3479a8"
+ styles.whiskerStrokeWidth=1.5 styles.outlierSize=2
+ styles.outlierStroke="#3479a8"
hist flipper_length_mm @penguin-flipper at=8,5,4,4
+ title="Flipper length distribution" xAxis{}= xAxis.grid=false
+ yAxis{}= yAxis.grid=true margin.top=16 margin.right=24
+ margin.bottom=44 margin.left=62
+ xAxisLabel="Flipper length (mm)" yAxisLabel=Records
+ yGridLines=4 binCount=20
table species,island,sex,bill_length_mm,bill_depth_mm,flipper_length_mm,body_mass_g,year
+ @penguin-records at=0,9,12,5 title="Selected observations"
+ xAxis{}= xAxis.grid=false yAxis{}= yAxis.grid=true
+ margin.top=16 margin.right=24 margin.bottom=44 margin.left=62
+ yGridLines=4 showDistributions=unset
chart parallel-coordinates @penguin-profile at=0,14,12,6
+ color=species title="Four measurements, one line per penguin"
+ xAxis{}= xAxis.grid=false yAxis{}= yAxis.grid=true
+ yGridLines=4 axes[]= axes.0.field=bill_length_mm
+ axes.0.inverted=false axes.1.field=bill_depth_mm
+ axes.1.inverted=false axes.2.field=flipper_length_mm
+ axes.2.inverted=false axes.3.field=body_mass_g
+ axes.3.inverted=false axes.4.field=island
+ axes.4.inverted=false


### VIEW: Gentoo on Biscoe
dashboard name="Gentoo on Biscoe"
grid rowHeight=76 padding=0 markers=false

scale @species-colors field=species
+ palette[]="#3479a8","#c77a45","#4b9688","#9c6eac","#bd596a"
+ mapping[]= mapping.0[]=Adelie,"#3479a8"
+ mapping.1[]=Chinstrap,"#c77a45" mapping.2[]=Gentoo,"#4b9688"
+ paletteId=unset order=unset overflow=unset

row species @penguin-species at=0,0,3,5 color=species
+ select.species=Gentoo title="Species · shared color key"
+ xAxis{}= xAxis.grid=true yAxis{}= yAxis.grid=false
+ margin.top=16 margin.right=24 margin.bottom=44 margin.left=62
+ xAxisLabel=Records yGridLines=4 minRowHeight=22
+ maxRowHeight=36
row island @penguin-island at=3,0,3,5 select.island=Biscoe
+ title="Sampling islands" xAxis{}= xAxis.grid=true yAxis{}=
+ yAxis.grid=false margin.top=16 margin.right=24
+ margin.bottom=44 margin.left=62 xAxisLabel=Records
+ yGridLines=4 minRowHeight=22 maxRowHeight=36
scatter x=flipper_length_mm y=body_mass_g @penguin-size
+ at=6,0,6,5 color=species title="Body size & flipper length"
+ xAxis{}= xAxis.grid=false yAxis{}= yAxis.grid=true
+ margin.top=16 margin.right=24 margin.bottom=44 margin.left=62
+ xAxisLabel="Flipper length (mm)" yAxisLabel="Body mass (g)"
+ yGridLines=4
table species,island,sex,bill_length_mm,bill_depth_mm,flipper_length_mm,body_mass_g,year
+ @penguin-records at=0,5,12,5 title="Selected observations"
+ xAxis{}= xAxis.grid=false yAxis{}= yAxis.grid=true
+ margin.top=16 margin.right=24 margin.bottom=44 margin.left=62
+ yGridLines=4 showDistributions=unset


### VIEW: Bill shape
dashboard name="Bill shape"
grid rowHeight=76 padding=0 markers=false

scale @species-colors field=species
+ palette[]="#3479a8","#c77a45","#4b9688","#9c6eac","#bd596a"
+ mapping[]= mapping.0[]=Adelie,"#3479a8"
+ mapping.1[]=Chinstrap,"#c77a45" mapping.2[]=Gentoo,"#4b9688"
+ paletteId=unset order=unset overflow=unset

scatter x=bill_length_mm y=bill_depth_mm @penguin-bill
+ at=0,0,7,6 color=species title="Bill shape separates species"
+ xAxis{}= xAxis.grid=false yAxis{}= yAxis.grid=true
+ margin.top=16 margin.right=24 margin.bottom=44 margin.left=62
+ xAxisLabel="Bill length (mm)" yAxisLabel="Bill depth (mm)"
+ yGridLines=4
row species @penguin-species at=7,0,5,6 color=species
+ title="Species · shared color key" xAxis{}= xAxis.grid=true
+ yAxis{}= yAxis.grid=false margin.top=16 margin.right=24
+ margin.bottom=44 margin.left=62 xAxisLabel=Records
+ yGridLines=4 minRowHeight=22 maxRowHeight=36
chart boxplot field=body_mass_g @penguin-mass at=0,6,6,5
+ color=species title="Body mass by species" xAxis{}=
+ xAxis.grid=false yAxis{}= yAxis.grid=true margin.top=16
+ margin.right=24 margin.bottom=44 margin.left=62
+ yAxisLabel="Body mass (g)" yGridLines=4
+ styles.boxFill="#3479a8" styles.boxStroke="#3479a8"
+ styles.boxStrokeWidth=0 styles.whiskerStroke="#3479a8"
+ styles.whiskerStrokeWidth=1.5 styles.outlierSize=2
+ styles.outlierStroke="#3479a8"
hist flipper_length_mm @penguin-flipper at=6,6,6,5
+ title="Flipper length distribution" xAxis{}= xAxis.grid=false
+ yAxis{}= yAxis.grid=true margin.top=16 margin.right=24
+ margin.bottom=44 margin.left=62
+ xAxisLabel="Flipper length (mm)" yAxisLabel=Records
+ yGridLines=4 binCount=20


### VIEW: Field report
dashboard name="Field report"
grid rowHeight=76 padding=0 markers=false
theme name=newsprint

scale @species-colors field=species
+ palette[]="#3479a8","#c77a45","#4b9688","#9c6eac","#bd596a"
+ mapping[]= mapping.0[]=Adelie,"#3479a8"
+ mapping.1[]=Chinstrap,"#c77a45" mapping.2[]=Gentoo,"#4b9688"
+ paletteId=unset order=unset overflow=unset

scatter x=flipper_length_mm y=body_mass_g @penguin-size
+ at=0,0,7,6 color=species
+ title="Gentoo penguins are the heavyweights" xAxis{}=
+ xAxis.grid=false yAxis{}= yAxis.grid=true margin.top=16
+ margin.right=24 margin.bottom=44 margin.left=62
+ xAxisLabel="Flipper length (mm)" yAxisLabel="Body mass (g)"
+ yGridLines=4
+ subtitle="Body mass (g) against flipper length (mm), 344 birds, Palmer Archipelago 2007–09"
+ note="Source: Palmer Station LTER; Gorman, Williams and Fraser (2014)"
row species @penguin-species at=7,0,5,6 color=species
+ title="Adelie make up almost half the sample" xAxis{}=
+ xAxis.grid=true yAxis{}= yAxis.grid=false margin.top=16
+ margin.right=24 margin.bottom=44 margin.left=62
+ xAxisLabel=Records yGridLines=4 minRowHeight=22
+ maxRowHeight=36 subtitle="Penguins measured, by species"
scatter x=bill_length_mm y=bill_depth_mm @penguin-bill
+ at=0,6,7,6 color=species
+ title="Bill shape tells the species apart" xAxis{}=
+ xAxis.grid=false yAxis{}= yAxis.grid=true margin.top=16
+ margin.right=24 margin.bottom=44 margin.left=62
+ xAxisLabel="Bill length (mm)" yAxisLabel="Bill depth (mm)"
+ yGridLines=4 subtitle="Bill depth against bill length (mm)"
+ note="Species that overlap in body size separate by bill shape."
chart boxplot field=body_mass_g @penguin-mass at=7,6,5,6
+ color=species
+ title="Chinstrap and Adelie weigh about the same" xAxis{}=
+ xAxis.grid=false yAxis{}= yAxis.grid=true margin.top=16
+ margin.right=24 margin.bottom=44 margin.left=62
+ yAxisLabel="Body mass (g)" yGridLines=4
+ styles.boxFill="#3479a8" styles.boxStroke="#3479a8"
+ styles.boxStrokeWidth=0 styles.whiskerStroke="#3479a8"
+ styles.whiskerStrokeWidth=1.5 styles.outlierSize=2
+ styles.outlierStroke="#3479a8"
+ subtitle="Body mass (g) by species"


