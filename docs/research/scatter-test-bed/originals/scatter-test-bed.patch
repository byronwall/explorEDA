+{
+  "checks": [
+    {
+      "name": "paired finite eligibility",
+      "passed": true,
+      "detail": "5 finite pairs, 3 exclusions; numeric strings included."
+    },
+    {
+      "name": "finite-number semantics",
+      "passed": true,
+      "detail": "Blank, boolean and nonfinite values are not measurements."
+    },
+    {
