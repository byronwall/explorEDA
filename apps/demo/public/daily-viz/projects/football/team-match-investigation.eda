eda query=linked
dashboard "Follow a team’s group profile back to its matches"
grid columns=12 rowHeight=76
id:cat=appearances.id label="Id"
match_id:cat=appearances.match_id label="Match id"
team:cat=appearances.team label="Team"
opponent:cat=appearances.opponent label="Opponent"
group_field:cat=appearances.group label="Group"
date:date=appearances.date label="Calendar date"
goals_for:num=appearances.goals_for label="Goals for (goals per team appearance)"
goals_against:num=appearances.goals_against label="Goals against (goals conceded per team appearance)"
points:num=appearances.points label="Points (group points, win 3 / draw 1 / loss 0)"
result:cat=appearances.result label="Result"
group_points:num=squad.points label="Team full group-stage points"
match_total:num=match.total_goals label="Original match total goals"
markdown @db-football-team-match-investigation-guide content="<p><strong>Which individual match appearances produced a team’s group-stage scoring and points?</strong></p><p>Selections filter peer views and records. The written findings describe the unfiltered snapshot, not the current selection.</p>" title="Entry question and filter scope" at=0,0,12,2
scatter @db-football-team-match-investigation-view-1 x=goals_for y=goals_against color=result title="Goals scored and conceded in one appearance" at=0,2,8,5 note="OpenFootball World Cup 2018 group-stage final scores; public-domain dedication." x.title="Goals for (goals per team appearance)" y.title="Goals against (goals conceded per team appearance)"
row @db-football-team-match-investigation-view-2 team title="Select a team" at=8,2,4,5 note="OpenFootball World Cup 2018 group-stage final scores; public-domain dedication." x.title="Source rows"
row @db-football-team-match-investigation-view-3 result title="Select a match result" at=0,7,6,4 note="OpenFootball World Cup 2018 group-stage final scores; public-domain dedication." x.title="Source rows"
boxplot @db-football-team-match-investigation-view-4 goals_for color=group_field title="Goals scored by group" at=6,7,6,4 note="OpenFootball World Cup 2018 group-stage final scores; public-domain dedication." y.title="Goals for (goals per team appearance)"
scatter @db-football-team-match-investigation-view-5 x=points y=group_points color=group_field title="Appearance points and full group points" at=0,11,8,5 note="OpenFootball World Cup 2018 group-stage final scores; public-domain dedication." x.title="Points (group points, win 3 / draw 1 / loss 0)" y.title="group points"
metric @db-football-team-match-investigation-view-6 count title="Team appearances, not distinct matches" at=8,11,4,2 note="OpenFootball World Cup 2018 group-stage final scores; public-domain dedication."
table @db-football-team-match-investigation-records date,team,opponent,goals_for,goals_against,points,group_points,match_total title="Matching source records and lookup values" at=0,16,12,5
