eda query=r
dashboard "Investigate warm months against their own season"
grid columns=12 rowHeight=76
sst:num=r.sst label="Sea-surface temperature (°C)"
month:num=r.month label="Month"
date:date=r.date label="Date"
month_label:cat=r.month_label label="Calendar month"
decade:cat=r.decade label="Decade"
climatology:num=r.climatology label="Climatology (°C)"
anomaly:num=r.anomaly label="Anomaly (°C)"
scatter @db-elnino-season-investigation-view-1 x=sst y=anomaly color=decade title="Temperature and seasonal anomaly" at=0,0,8,5 x.title="Sea-surface temperature (°C)" y.title="Anomaly (°C)"
row @db-elnino-season-investigation-view-2 decade title="Select a decade" at=8,0,4,5 x.title="Rows"
boxplot @db-elnino-season-investigation-view-3 anomaly color=month_label title="Anomalies by calendar month" at=0,5,6,4 y.title="Anomaly (°C)"
hist @db-elnino-season-investigation-view-4 anomaly bins=30 title="Brush an anomaly range" at=6,5,6,4 x.title="Anomaly (°C)" y.title="Rows"
line @db-elnino-season-investigation-view-5 x=date y=anomaly title="Monthly anomalies in time" at=0,9,8,5 x.title="Date" y.title="Anomaly (°C)"
metric @db-elnino-season-investigation-view-6 count title="Calendar months matching the filters" at=8,9,4,2
table @db-elnino-season-investigation-records date,sst,climatology,anomaly,month_label title="Matching source records and lookup values" at=0,14,12,5
