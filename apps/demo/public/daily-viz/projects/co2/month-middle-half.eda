eda query=r
dashboard "The middle half of centered CO2 weeks, month by month"
grid columns=12 rowHeight=76
composition @cp-co2-month-middle-half width=960 height=680 at=0,0,12,9 {
  title "The middle half of centered CO2 weeks, month by month" at=32,28 fontSize=24
  subtitle "Native unweighted quartiles form a band and medians are connected across ordered months." at=32,78 fontSize=13
  scale numeric r.residual zero=true
  unit Calendar at=90,155 size=820x330 axisTitles.y="CO2 minus annual measured-week mean (ppmv)" {
    label show=false
    summary Weeks groupField=r.month_label measureField=r.residual y=r.residual
  }
  rule "Annual reference" at=5,0 unit=Calendar axis=y value.value=0
  legend "Reading the summary" at=100,545 unit=Calendar mark=Weeks {
    item "Middle half of measured weeks" mark=Weeks part=band
    item "Median" mark=Weeks part=median
  }
  footnote "Keeling and Whorf / CDIAC; statsmodels historical snapshot; public domain." at=32,626 fontSize=10
  footnote "Units, denominator, transformation and evidence: companion design note; snapshot findings do not change with filters." at=32,648 fontSize=10
}
