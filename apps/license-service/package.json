{
  "name": "license-service",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:migrate:local": "wrangler d1 migrations apply exploreda-licenses --local --persist-to .wrangler/state",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "admin": "node --experimental-strip-types scripts/admin.ts",
    "replay": "node --experimental-strip-types scripts/replay.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "keygen": "node --experimental-strip-types scripts/keygen.ts"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "@repo/typescript-config": "workspace:*",
    "typescript": "~5.4.5",
    "vitest": "^3.0.8",
    "wrangler": "4.135.0",
    "@types/node": "^22.13.10"
  }
}
