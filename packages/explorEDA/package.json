{
  "name": "exploreda",
  "private": false,
  "version": "0.0.6",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/byronwall/explorEDA.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "verify:lean": "node scripts/verify-lean-bundle.mjs",
    "prettier": "prettier --write ./src",
    "eslint": "eslint . --max-warnings=0"
  },
  "files": [
    "dist/**",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/ExplorEda.d.ts",
      "require": "./dist/ExplorEda.cjs",
      "import": "./dist/ExplorEda.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "require": "./dist/core.cjs",
      "import": "./dist/core.js"
    },
    "./charts/*": {
      "types": "./dist/charts/*.d.ts",
      "require": "./dist/charts/*.cjs",
      "import": "./dist/charts/*.js"
    },
    "./dist/ExplorEda.css": "./dist/ExplorEda.css",
    "./calculations": {
      "types": "./dist/calculations.d.ts",
      "require": "./dist/calculations.cjs",
      "import": "./dist/calculations.js"
    }
  },
  "main": "./dist/ExplorEda.cjs",
  "module": "./dist/ExplorEda.js",
  "types": "./dist/ExplorEda.d.ts",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/postcss": "^4.0.14",
    "@tiptap/extension-color": "^2.11.5",
    "@tiptap/extension-list-item": "^2.11.5",
    "@tiptap/extension-text-style": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "crossfilter2": "^1.5.4",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "lucide-react": "^0.475.0",
    "natsort": "^2.0.3",
    "next-themes": "^0.4.4",
    "ohm-js": "^17.1.0",
    "react-colorful": "^5.6.1",
    "react-fast-compare": "^3.2.2",
    "react-grid-layout": "^1.5.0",
    "react-resizable": "^3.0.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.174.0",
    "use-custom-compare": "^1.4.0",
    "zustand": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@repo/typescript-config": "workspace:*",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-shape": "^3.1.7",
    "@types/d3-time-format": "^4.0.3",
    "@types/jest": "^29.5.14",
    "@types/natsort": "^2.0.0",
    "@types/node": "^22.13.4",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/react-grid-layout": "^1.3.5",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.7",
    "d3-shape": "^3.2.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.14",
    "tsup": "^8.4.0",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  }
}
