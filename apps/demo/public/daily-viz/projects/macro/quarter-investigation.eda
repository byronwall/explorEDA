eda query=r
dashboard "Investigate a historical quarter, not today’s economy"
grid columns=12 rowHeight=76
id:cat=r.id label="Id"
year:num=r.year label="Year"
quarter:num=r.quarter label="Quarter"
realgdp:num=r.realgdp label="Realgdp (billions, chained 2005 US$)"
realcons:num=r.realcons label="Realcons (billions, chained 2005 US$)"
realinv:num=r.realinv label="Realinv (billions, chained 2005 US$)"
realgovt:num=r.realgovt label="Realgovt (billions, chained 2005 US$)"
realdpi:num=r.realdpi label="Realdpi (billions, chained 2005 US$)"
cpi:num=r.cpi label="Cpi (CPI index)"
m1:num=r.m1 label="M1 (billions of nominal US dollars)"
tbilrate:num=r.tbilrate label="Tbilrate (%)"
unemp:num=r.unemp label="Unemp (%)"
pop:num=r.pop label="Pop (millions of people)"
infl:num=r.infl label="Infl (%)"
realint:num=r.realint label="Realint (%)"
date:date=r.date label="Calendar date"
decade:cat=r.decade label="Decade"
gdp_growth:num=r.gdp_growth label="Gdp growth (%)"
consumption_share:num=r.consumption_share label="Consumption share (%)"
gdp_change:num=r.gdp_change label="Gdp change (billions, chained 2005 US$)"
unemp_change:num=r.unemp_change label="Unemp change (percentage points)"
markdown @db-macro-quarter-investigation-guide content="<p><strong>Which quarters combine GDP contraction, unemployment change, and a particular inflation context?</strong></p><p>Selections filter peer views and records. The written findings describe the unfiltered snapshot, not the current selection.</p>" title="Entry question and filter scope" at=0,0,12,2
scatter @db-macro-quarter-investigation-view-1 x=gdp_change y=unemp_change color=decade title="GDP change and unemployment change" at=0,2,8,5 note="U.S. macroeconomic sources via statsmodels; historical vintage; public domain." x.title="Gdp change (billions, chained 2005 US$)" y.title="Unemp change (percentage points)"
row @db-macro-quarter-investigation-view-2 decade title="Select a historical decade" at=8,2,4,5 note="U.S. macroeconomic sources via statsmodels; historical vintage; public domain." x.title="Source rows"
hist @db-macro-quarter-investigation-view-3 gdp_growth bins=26 title="Brush annualized GDP growth" at=0,7,6,4 note="U.S. macroeconomic sources via statsmodels; historical vintage; public domain." x.title="Gdp growth (%)" y.title="Source rows"
scatter @db-macro-quarter-investigation-view-4 x=unemp y=infl color=decade title="Inflation and unemployment levels" at=6,7,6,4 note="U.S. macroeconomic sources via statsmodels; historical vintage; public domain." x.title="Unemp (%)" y.title="Infl (%)"
line @db-macro-quarter-investigation-view-5 x=date y=realgdp title="GDP level through the supplied quarters" at=0,11,8,5 note="U.S. macroeconomic sources via statsmodels; historical vintage; public domain." x.title="Calendar date" y.title="Realgdp (billions, chained 2005 US$)"
metric @db-macro-quarter-investigation-view-6 count title="Quarter rows matching the filters" at=8,11,4,2 note="U.S. macroeconomic sources via statsmodels; historical vintage; public domain."
table @db-macro-quarter-investigation-records date,realgdp,gdp_growth,unemp,unemp_change,infl title="Matching source records and lookup values" at=0,16,12,5
