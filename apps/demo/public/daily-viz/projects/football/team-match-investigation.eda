eda query=linked
dashboard "Follow a team’s group profile back to its matches"
grid columns=12 rowHeight=76
team:cat=appearances.team label="Team"
opponent:cat=appearances.opponent label="Opponent"
group_field:cat=appearances.group label="Group"
date:date=appearances.date label="Date"
goals_for:num=appearances.goals_for label="Goals scored"
goals_against:num=appearances.goals_against label="Goals conceded"
points:num=appearances.points label="Points"
result:cat=appearances.result label="Result"
group_points:num=squad.points label="Team points"
match_total:num=match.total_goals label="Goals in the match"
scatter @db-football-team-match-investigation-view-1 x=goals_for y=goals_against color=result title="Goals scored and conceded in one appearance" at=0,0,8,5 x.title="Goals scored" y.title="Goals conceded"
row @db-football-team-match-investigation-view-2 team title="Select a team" at=8,0,4,5 x.title="Rows"
row @db-football-team-match-investigation-view-3 result title="Select a match result" at=0,5,6,4 x.title="Rows"
boxplot @db-football-team-match-investigation-view-4 goals_for color=group_field title="Goals scored by group" at=6,5,6,4 y.title="Goals scored"
scatter @db-football-team-match-investigation-view-5 x=points y=group_points color=group_field title="Appearance points and full group points" at=0,9,8,5 x.title="Points" y.title="group points"
metric @db-football-team-match-investigation-view-6 count title="Team appearances, not distinct matches" at=8,9,4,2
table @db-football-team-match-investigation-records date,team,opponent,goals_for,goals_against,points,group_points,match_total title="Matching source records and lookup values" at=0,14,12,5
