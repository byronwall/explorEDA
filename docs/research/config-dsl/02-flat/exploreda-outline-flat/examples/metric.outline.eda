eda 1 outline
sources
  orders salesRows
    label Order book
    fields
      revenue Revenue
        label Revenue ($)
        expect numeric
        format currency
        currency USD
      margin Margin
        label Margin ($)
        expect numeric
      category Category
        expect categorical
      region Region
        expect categorical
      order Order ID
use orders

metric aggregation count
  id order-count
  title Orders

metric aggregation sum measure revenue
  id revenue-total
  title Total revenue
