eda query=r
dashboard "A comparison boundary does not make a causal experiment"
grid columns=12 rowHeight=76
composition @cp-nile-flow-boundary width=960 height=640 at=0,0,12,9 {
  title "A comparison boundary does not make a causal experiment" at=32,28 fontSize=24
  subtitle "An annual-volume path keeps wet and dry years visible, with a fixed vertical comparison boundary." at=32,78 fontSize=13
  scale numeric r.year nice=false
  scale numeric r.volume zero=false
  unit Years at=90,155 size=820x335 axisTitles.x=Year axisTitles.y="Annual flow at Aswan (10^8 m3)" {
    label show=false
    path Flow x=r.year y=r.volume orderField=r.year
    point Annual x=r.year y=r.volume radius=2
  }
  rule "1898 comparison boundary" at=6,-335 unit=Years value.value=1898
  footnote "Aswan historical Nile observations via statsmodels; public domain." at=32,586 fontSize=10
  footnote "Units, denominator, transformation and evidence: companion design note; snapshot findings do not change with filters." at=32,608 fontSize=10
}
