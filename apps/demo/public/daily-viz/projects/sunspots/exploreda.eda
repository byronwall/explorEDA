project @sunspots

source @r key=id path=data/r.csv {
  field id "id" string
  field year "year" number
  field activity "activity" number
  field era "era" string
  field smooth11 "smooth11" number
  field departure "departure" number
}

query @r "r" glyph=◆ {
  source r
  calc abs_departure "Absolute departure" = ["r.departure"] == null ? null : max(["r.departure"], 0 - ["r.departure"])
}
