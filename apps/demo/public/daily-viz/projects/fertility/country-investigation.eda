eda query=r
dashboard "Investigate twelve countries' fertility paths"
grid columns=12 rowHeight=76
country:cat=r.country label="Country"
code:cat=r.code label="Code"
year:num=r.year label="Year"
fertility:num=r.fertility label="Fertility (births/woman)"
decade:cat=r.decade label="Decade"
scatter @db-fertility-country-investigation-view-1 x=year y=fertility color=country title="Recorded country-year rates" at=0,0,8,5 x.title="Year" y.title="Fertility (births/woman)"
row @db-fertility-country-investigation-view-2 country title="Select a country" at=8,0,4,5 x.title="Rows"
hist @db-fertility-country-investigation-view-3 year bins=54 title="Brush a year range" at=0,5,6,4 x.title="Year" y.title="Rows"
boxplot @db-fertility-country-investigation-view-4 fertility color=decade title="Available values by decade" at=6,5,6,4 y.title="Fertility (births/woman)"
ecdf @db-fertility-country-investigation-view-5 fertility direction=below title="Distribution of selected period rates" at=0,9,8,5 x.title="Fertility (births/woman)"
metric @db-fertility-country-investigation-view-6 count title="Retained country-year cells" at=8,9,4,2
table @db-fertility-country-investigation-records country,code,year,fertility,decade title="Matching source records and lookup values" at=0,14,12,5
