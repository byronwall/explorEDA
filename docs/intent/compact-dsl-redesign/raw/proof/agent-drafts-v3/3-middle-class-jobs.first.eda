dashboard "Middle-class jobs"
composition @jobs height=704 {
  scale numeric Year nice=false zero=false ticks=ends
  scale numeric "Jobs per 1000" max=85
  measure max("Group order")
  measure max("Group change") name=Change
  measure last("Women minus men") orderField=Year name=Gap
  scale value Gap colors=#1a8fd0,#e3173b center=#b9b9b9 max=100 label="Share of women minus share of men, points"
  title "The Changing Nature of Middle-Class Jobs" at=32,24 fontSize=26
  subtitle "Jobs per 1,000 workers by occupation, colored by the gap between women's and men's shares" at=32,64 width=640
  footnote "Source: U.S. Census Bureau, American Community Survey" at=32,680
  unit Groups at=56,176 size=120x180 axis=true {
    repeat Group columns=5 gap=46 orderBy="Group order" limit=10
    label value=Change format="+N jobs"
    path Occupations x=Year y="Jobs per 1000" orderField=Year color=Gap
    point Ends x=Year y="Jobs per 1000" pick=ends color=Gap
  }
  legend Key at=620,130 unit=Groups mark=Occupations direction=row
  note "Registered nurses" at=-30,-40 on=Groups[Professionals] mark=Occupations pick=max
  note "Secretaries" at=-30,-40 on=Groups["Admin support"] mark=Occupations pick=max
}
row Group
hist @share "Women share"

layout {
  7: jobs
  4: Group share
}
