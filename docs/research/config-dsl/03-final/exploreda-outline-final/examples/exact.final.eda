source orders=salesRows
revenue:num=Revenue
cost:num=Cost

calc profit=revenue-cost
scatter @p x=revenue y=profit
+ margin.left=64 xGridLines=6 xAxis.grid=true

# Choose exact filters OR where pairs on this chart, not both.
table @raw
+ columns=[{"id":"rev","field":"Revenue","width":180},{"id":"p","field":"profit"}]
+ filters=[{"type":"range","field":"profit","min":0}]
+ globalSearch="" sortBy=Revenue sortDirection=desc
