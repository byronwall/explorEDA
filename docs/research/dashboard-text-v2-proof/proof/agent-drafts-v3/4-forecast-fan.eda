dashboard "Forecast fan"
composition @fan height=540 {
  scale numeric Year
  scale numeric Central domain=instance
  measure last(Central) orderField=Year name=Latest
  title "Two measures, three years ahead" at=32,24
  subtitle "Central projection with nested uncertainty bands" at=32,60
  footnote "Bands show the 10th to 90th, 20th to 80th, 30th to 70th, and 40th to 60th percentiles." at=32,516
  unit Frames at=48,110 size=380x300 axis=true axisTitles.y=Percent {
    repeat Measure columns=2 gap=72
    label value=Latest
    band "80%" x=Year y=Central orderField=Year lowerField=P10 upperField=P90 fill=#1f4e8c opacity=0.12
    band "60%" x=Year y=Central orderField=Year lowerField=P20 upperField=P80 fill=#1f4e8c opacity=0.16
    band "40%" x=Year y=Central orderField=Year lowerField=P30 upperField=P70 fill=#1f4e8c opacity=0.20
    band "20%" x=Year y=Central orderField=Year lowerField=P40 upperField=P60 fill=#1f4e8c opacity=0.26
    path Central x=Year y=Central orderField=Year
  }
  rule "Projection" at=0,0 unit=Frames axis=x value=2025 shade=after
  rule "2%" at=0,0 unit=Frames axis=y value=2 repeats="GDP growth"
  legend Key at=48,470 unit=Frames mark=Central {
    item "Central projection" mark=Central
    item "10th to 90th percentile" mark="80%"
    item "20th to 80th percentile" mark="60%"
    item "30th to 70th percentile" mark="40%"
    item "40th to 60th percentile" mark="20%"
  }
}
line @trend x=Year y=Central
row Kind

layout {
  6: fan
  4: trend:8 Kind:4
}
