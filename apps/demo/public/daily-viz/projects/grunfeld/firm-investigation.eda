eda query=linked
dashboard "Trace one firm's year back to its company record"
grid columns=12 rowHeight=76
invest:num=r.invest label="Investment ($M, 1947)"
value:num=r.value label="Market value ($M, 1947)"
firm:cat=r.firm label="Firm"
year:num=r.year label="Year"
invest_index:num=r.invest_index label="Investment index (first year = 100)"
invest_change:num=r.invest_change label="Change in investment ($M, 1947)"
value_change:num=r.value_change label="Change in market value ($M, 1947)"
company_mean:num=company.invest_mean label="Firm mean investment ($M, 1947)"
scatter @db-grunfeld-firm-investigation-view-1 x=value y=invest color=firm title="Market value and investment" at=0,0,8,5 x.title="Market value ($M, 1947)" y.title="Investment ($M, 1947)"
row @db-grunfeld-firm-investigation-view-2 firm title="Select a firm" at=8,0,4,5 x.title="Rows"
scatter @db-grunfeld-firm-investigation-view-3 x=value_change y=invest_change title="Within-firm annual changes" at=0,5,6,4 x.title="Change in market value ($M, 1947)" y.title="Change in investment ($M, 1947)"
hist @db-grunfeld-firm-investigation-view-4 invest_index bins=24 title="Investment-index distribution" at=6,5,6,4 x.title="Investment index (first year = 100)" y.title="Rows"
scatter @db-grunfeld-firm-investigation-view-5 x=year y=invest color=firm title="Recorded investment through time" at=0,9,8,5 x.title="Year" y.title="Investment ($M, 1947)"
metric @db-grunfeld-firm-investigation-view-6 count title="Firm-years in the selection" at=8,9,4,2
table @db-grunfeld-firm-investigation-records firm,year,invest,value,invest_change,company_mean title="Matching source records and lookup values" at=0,14,12,5
