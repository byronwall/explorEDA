project @t6

connection @retail driver=duckdb path=data/retail.duckdb

source @catalog-sales db=retail table=catalog_sales

source @customer db=retail table=customer

source @customer-address db=retail table=customer_address

source @customer-demographics db=retail table=customer_demographics

source @web-sales db=retail table=web_sales

relate @rel-catalog-sales-cs_bill_customer_sk-customer-c_customer_sk catalog-sales.cs_bill_customer_sk -> customer.c_customer_sk "Catalog sales to Customer"
relate @rel-web-sales-ws_bill_customer_sk-customer-c_customer_sk web-sales.ws_bill_customer_sk -> customer.c_customer_sk "Web sales to Customer"
relate @rel-customer-c_current_cdemo_sk-customer-demographics-cd_demo_sk customer.c_current_cdemo_sk -> customer-demographics.cd_demo_sk "Customer to Customer demographics"
relate @rel-customer-c_current_addr_sk-customer-address-ca_address_sk customer.c_current_addr_sk -> customer-address.ca_address_sk "Customer to Customer address"

query @catalog-sales glyph=C {
  source catalog-sales
  lookup customer via=rel-catalog-sales-cs_bill_customer_sk-customer-c_customer_sk on=catalog-sales.cs_bill_customer_sk
  lookup customer_demographics via=rel-customer-c_current_cdemo_sk-customer-demographics-cd_demo_sk on=customer.c_current_cdemo_sk
  lookup customer_address via=rel-customer-c_current_addr_sk-customer-address-ca_address_sk on=customer.c_current_addr_sk
}

query @all-sales "Web and catalog buyers" glyph=B {
  source catalog-sales
  append web-sales field=channel
  calc buyer "Buyer key" = ["catalog-sales.cs_bill_customer_sk"] == null ? ["web-sales.ws_bill_customer_sk"] : ["catalog-sales.cs_bill_customer_sk"]
  lookup customer via=rel-catalog-sales-cs_bill_customer_sk-customer-c_customer_sk on=all-sales.buyer
  lookup customer_demographics via=rel-customer-c_current_cdemo_sk-customer-demographics-cd_demo_sk on=customer.c_current_cdemo_sk
  lookup customer_address via=rel-customer-c_current_addr_sk-customer-address-ca_address_sk on=customer.c_current_addr_sk
}
