{
  "name": "data-viz",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "pgm:view": "pgm viewer --data-dir ./pgm/data",
    "pgm": "pgm --local ./pgm/data --project untitled-project",
    "check": "pnpm check:ui && pnpm --recursive --if-present run build && pnpm --recursive --if-present run check-types && pnpm --recursive --if-present run test",
    "release": "pnpm check && changeset publish",
    "check:ui": "node scripts/check-ui.mjs",
    "changeset:add": "node scripts/add-changeset.mjs"
  },
  "dependencies": {
    "@changesets/cli": "^2.28.1",
    "prettier": "^3.5.3",
    "typescript": "~5.4.5"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@byronwallrus/product-grid-cli": "0.2.0"
  }
}
