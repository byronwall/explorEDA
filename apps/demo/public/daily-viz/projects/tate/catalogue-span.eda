eda query=r
dashboard "Two dates, sixty artists, and one 138-year span"
grid columns=12 rowHeight=76
composition @cp-tate-catalogue-span width=1010 height=1040 at=0,0,12,14 {
  title "Two dates, sixty artists, and one 138-year span" at=32,28 fontSize=24
  subtitle "One bar per catalogue record, from birth year to death year. Open bars have no death year in the archive; the longest bar names a family, not a person." at=32,74 fontSize=13
  scale numeric r.birth_year name=Year nice=false min=1680 max=2015
  measure min(r.birth_year) name=Born filters=ignore
  legend "Death year" at=230,118 unit=Artists mark=Records width=600
  unit Artists at=32,150 size=740x10 axisTitles.x="Year" {
    repeat r.name order=value orderBy=Born direction=asc gap=3 limit=60
    label width=210 fontSize=9
    span Records x=r.birth_year startField=r.birth_year endField=r.death_year colorField=r.death_status {
      colors=#2f6db5,#c08a2b inset=1
    }
  }
  footnote "Tate collection metadata, October 2014 archive; first 60 artist records alphabetically; CC0 1.0." at=32,1004 fontSize=10
}
