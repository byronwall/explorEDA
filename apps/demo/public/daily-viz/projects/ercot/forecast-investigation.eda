eda query=r
dashboard "Investigate the ERCOT forecast, hour by hour"
grid columns=12 rowHeight=76
date:date=r.date label="Hour (UTC)"
actual:num=r.actual label="Actual (MWh)"
forecast:num=r.forecast label="Forecast (MWh)"
month:num=r.month label="Month"
month_label:cat=r.month_label label="Calendar month"
hour:num=r.hour label="Hour (UTC)"
hour_label:cat=r.hour_label label="Clock hour"
error:num=r.error label="Error (MWh)"
abs_error:num=r.abs_error label="Absolute error (MWh)"
direction:cat=r.direction label="Direction"
scatter @db-ercot-forecast-investigation-view-1 x=forecast y=error color=direction title="Forecast level and signed error" at=0,0,8,5 x.title="Forecast (MWh)" y.title="Error (MWh)"
row @db-ercot-forecast-investigation-view-2 direction title="Select an error direction" at=8,0,4,5 x.title="Rows"
hist @db-ercot-forecast-investigation-view-3 abs_error bins=30 title="Brush an absolute-error range" at=0,5,6,4 x.title="Absolute error (MWh)" y.title="Rows"
boxplot @db-ercot-forecast-investigation-view-4 error color=month_label title="Error distribution by UTC month" at=6,5,6,4 y.title="Error (MWh)"
heatmap @db-ercot-forecast-investigation-view-5 hour_label maxCategories=24 columnField=month_label aggregation=average measureField=abs_error title="Clock hour and month" at=0,9,8,5
metric @db-ercot-forecast-investigation-view-6 count title="Supplied hours matching the filters" at=8,9,4,2
table @db-ercot-forecast-investigation-records date,actual,forecast,error,abs_error,hour_label title="Matching source records and lookup values" at=0,14,12,5
