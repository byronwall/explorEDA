{
  "name": "exploreda-standalone-charts-example",
  "private": true,
  "type": "module",
  "scripts": {
    "pack-lib": "pnpm --dir ../../packages/explorEDA pack --out ../../examples/standalone-charts/vendor/exploreda.tgz",
    "install-lib": "pnpm run pack-lib && pnpm install --force",
    "dev": "vite --host 127.0.0.1 --port 5480 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5481 --strictPort"
  },
  "dependencies": {
    "exploreda": "file:vendor/exploreda.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.4.5",
    "vite": "^6.1.0"
  }
}
