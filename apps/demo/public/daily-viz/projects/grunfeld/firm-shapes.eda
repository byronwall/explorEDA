eda query=r
dashboard "An indexed sparkline grid trades magnitude for shape"
grid columns=12 rowHeight=76
composition @cp-grunfeld-firm-shapes width=1080 height=1170 at=0,0,12,9 {
  title "An indexed sparkline grid trades magnitude for shape" at=32,28 fontSize=24
  subtitle "A grid of indexed investment paths gives each firm room to show its own trajectory, with the latest observation marked." at=32,78 fontSize=13
  scale numeric r.year nice=false ticks=ends
  scale numeric r.invest_index domain=instance zero=false
  unit Firms at=65,160 size=250x120 axisTitles.x=Year {
    repeat r.firm arrangement=grid columns=3 gap=68 order=label
    label fontSize=12
    path Indexed x=r.year y=r.invest_index orderField=r.year
    point Latest x=r.year y=r.invest_index orderField=r.year show=last radius=3
  }
  footnote "Grunfeld investment panel, Kleiber and Zeileis / statsmodels; public domain." at=32,1134 fontSize=10
}
